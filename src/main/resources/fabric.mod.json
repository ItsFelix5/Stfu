{
  "schemaVersion": 1,
  "id": "stfu",
  "version": "${version}",
  "name": "Stfu",
  "description": "A mod that fixes some annoyances!",
  "icon": "assets/stfu/icon.png",
  "authors": ["ItsFelix5"],
  "contact": {
    "homepage": "https://modrinth.com/mod/shuttfup",
    "issues": "https://github.com/ItsFelix5/stfu/issues",
    "sources": "https://github.com/ItsFelix5/stfu"
  },
  "entrypoints": {
    "main": ["stfu.Main"],
    "modmenu": ["stfu.ModMenu"]
  },
  "license": "MIT",
  "environment": "client",
  "accessWidener": "stfu.accesswidener",
  "mixins": ["stfu.mixins.json"],
  "depends": {
    "fabricloader": "*",
    "minecraft": "*",
    "fabric": "*",
    "yet_another_config_lib_v3": "*"
  },
  "recommends": {
    "modmenu": "*"
  },
  "custom": {
    "mc-publish": {
      "modrinth": "Rg9WdvvR",
      "curseforge": 1111802,
      "loaders": ["fabric", "quilt"],
      "dependencies": [
        "fabric(required){modrinth:fabric-api}{curseforge:fabric-api}",
        "yet_another_config_lib_v3(required){modrinth:yacl}{curseforge:yacl}",
        "modmenu(recommended)"
      ]
    },
    "badoptimizations:incompatibilities": [
      "enable_sky_color_caching",
      "enable_lightmap_caching",
      "enable_sky_angle_caching_in_worldrenderer"
    ]
  }
}
